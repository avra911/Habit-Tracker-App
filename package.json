{
  "name": "habit-tracker-app",
  "homepage": "https://avra911.github.io/Habit-Tracker-App/",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "build": "EXPO_PUBLIC_BASE_URL=/Habit-Tracker-App npx expo export -p web",
    "predeploy": "npm run build",
    "deploy": "cd dist && git init && git checkout -b gh-pages && git add . && git commit -m 'Fix assets path' && git remote add origin https://github.com/avra911/Habit-Tracker-App.git && git push origin gh-pages --force && cd .."
  },
  "dependencies": {
    "@expo/metro-runtime": "~6.1.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "expo": "~54.0.33",
    "expo-router": "~6.0.23",
    "expo-status-bar": "~3.0.9",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "react-native": "0.81.5",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-web": "^0.21.0"
  },
  "private": false,
  "devDependencies": {
    "gh-pages": "^6.3.0"
  }
}
